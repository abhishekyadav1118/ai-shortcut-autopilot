# ================================================================
# AI Tools YouTube Autopilot - Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit your .env file or share these keys in chat.
# ================================================================

# LLM Provider Key (Gemini free tier from Google AI Studio, or Anthropic API)
LLM_API_KEY=your_gemini_or_anthropic_api_key_here

# Pexels Video API Key (Free from pexels.com/api)
PEXELS_API_KEY=your_pexels_api_key_here

# YouTube Data API v3 OAuth Credentials (from Google Cloud Console Desktop App)
YOUTUBE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token_from_autopilot_auth
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# Telegram Bot Notifications (Optional - obtain from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
